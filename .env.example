# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Sent as HTTP-Referer for OpenRouter app attribution.
# OPENROUTER_HTTP_REFERER=http://localhost:3000

# Optional. Default: openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional. Generate missing corpus embeddings on postinstall / first local run.
# RAG_INGEST_EMBED=1
